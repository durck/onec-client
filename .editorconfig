root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.go]
indent_style = tab

[*.{md,json,yml,yaml}]
indent_style = space
indent_size = 2

# Fixture byte hashes are authoritative; do not normalize these files.
[go-onec/testdata/**]
end_of_line = unset
insert_final_newline = unset
