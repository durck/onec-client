# Track product source only; keep raw local evidence outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/licenses/
!/.github/
!/.editorconfig
!/go-onec/
!/tools/
!/docs/

*.kirbi
*.ccache
*.key
*.pem
.env
.env.*
!.env.example
*.test
coverage.out

# Local credentials, captures, reports and build products.
*.pfx
*.p12
*.pcap
*.pcapng
*.dmp
*.exe
*.dll
*.zip
*.7z
*.bundle
*.log
**/node_modules/
**/__pycache__/
.DS_Store
Thumbs.db

# Audit output can contain real target and account inventory.
**/onec-checklist-*.json
**/audit*.json
**/targets.txt
**/users.txt
**/passwords.txt
